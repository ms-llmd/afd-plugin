{
  "name": "deepseek-v2-lite-2a2f-graph-singlenode",
  "model": {
    "family": "deepseek_v2_lite",
    "model_id": "deepseek-ai/DeepSeek-V2-Lite",
    "trust_remote_code": true,
    "extra_serve_args": {}
  },
  "topology": {
    "strategy": "colocation",
    "afd_enabled": true,
    "num_attention_ranks": 2,
    "num_ffn_ranks": 2,
    "attention": {"data_parallel_size": 1, "tensor_parallel_size": 2},
    "ffn": {"data_parallel_size": 1, "tensor_parallel_size": 2}
  },
  "placement": {"node_mode": "single"},
  "execution": {"mode": "graph", "cudagraph_capture_size": 64},
  "dbo": {"enabled": true, "decode_token_threshold": 2, "prefill_token_threshold": 12},
  "serving": {
    "max_num_seqs": 64,
    "max_num_batched_tokens": 64,
    "max_model_len": 8192,
    "enable_expert_parallel": true
  }
}
