#
# docker/Dockerfile.ci adapted for OpenShift's restricted SCC (random UID in
# group 0), per the deploy-afd-k8s skill's documented fix-up: no BuildKit-only
# COPY --link (imagebuilder/buildah reject it), a writable HOME, and a
# group-writable app dir. Adds scipy, which Inkling's tower construction
# imports (vllm/models/inkling/common/towers.py, plan_out_scales) even under
# --language-model-only, and which is declared nowhere in pyproject.toml.
# Not part of the CI image; scratch build artifact for k8s bench pods only.
ARG VLLM_BASE_IMAGE=vllm/vllm-openai
ARG VLLM_BASE_TAG=v0.26.0

FROM ${VLLM_BASE_IMAGE}:${VLLM_BASE_TAG} AS deps

ARG APP_DIR=/opt/afd-plugin
WORKDIR ${APP_DIR}

RUN ln -sf /usr/bin/python3 /usr/bin/python

RUN mkdir -p afd_plugin && touch afd_plugin/__init__.py

RUN apt-get update && \
    apt-get install -y --no-install-recommends git jq && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

COPY pyproject.toml setup.py uv.lock README.md LICENSE ./

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AFD_BUILD_ASCEND_OPS=0 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_LINK_MODE=copy \
    SETUPTOOLS_SCM_PRETEND_VERSION_FOR_VLLM_AFD_PLUGIN=0.0.0+ci \
    SETUPTOOLS_SCM_PRETEND_VERSION=0.0.0+ci \
    HOME=${APP_DIR}

RUN uv export --locked --group dev --no-emit-project -o /tmp/requirements-dev.txt \
    && uv pip install --system -r /tmp/requirements-dev.txt \
    && uv pip install --system -e . \
    && uv pip install --system scipy

FROM deps
ARG APP_DIR=/opt/afd-plugin
WORKDIR ${APP_DIR}

COPY . .

# Restricted SCC runs a random UID in group 0; make the app dir writable by
# that group instead of assuming a fixed UID.
RUN chgrp -R 0 ${APP_DIR} && chmod -R g=u ${APP_DIR}

ENTRYPOINT []
